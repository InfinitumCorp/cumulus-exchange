# Cumulus domain. Hosted at Cloudflare. These names are configuration only.
# Nothing in this repository creates DNS records or calls the Cloudflare API.
CUMULUS_ROOT_DOMAIN=cumuluscloud.app
CUMULUS_ID_HOST=id.cumuluscloud.app
CUMULUS_CLOUD_HOST=cloud.cumuluscloud.app
CUMULUS_MAIL_HOST=mail.cumuluscloud.app

# Derived when unset:
# CUMULUS_KEYCLOAK_ISSUER=https://id.cumuluscloud.app/realms/cumulus
# CUMULUS_KEYCLOAK_AUDIENCE=https://id.cumuluscloud.app
# CUMULUS_KEYCLOAK_JWKS_URL=https://id.cumuluscloud.app/realms/cumulus/protocol/openid-connect/certs
# CUMULUS_PUBLIC_BASE_URL=https://cloud.cumuluscloud.app
# CORS defaults to the three https origins. Exact origins only, comma-separated. No wildcard.
# CUMULUS_CORS_ORIGINS=https://id.cumuluscloud.app,https://cloud.cumuluscloud.app,https://mail.cumuluscloud.app

# Required before the Drive process will listen. Do not commit real values.
# CUMULUS_KMS_MASTER_KEY=
# CUMULUS_BOOTSTRAP_TOKEN=
# CUMULUS_SHARE_SECRET=
# CUMULUS_DATA_DIR=cloud/var
# DATABASE_URL=postgres://cumulus:cumulus@127.0.0.1:54329/cumulus
# CUMULUS_STORAGE_DRIVER=filesystem
# CUMULUS_AUTH_MODE=keycloak
# Supabase mode verifies the project JWKS and reads app_metadata.cid.
# Point this at the local CLI (http://127.0.0.1:54321). The live project ref is refused.
# CUMULUS_SUPABASE_URL=http://127.0.0.1:54321
# CUMULUS_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
# CUMULUS_S3_BUCKET=cumulus-drive
# CUMULUS_S3_REGION=local

# @conjure: hosted Conjure prediction service. Key from the Conjure staff dashboard; server-side only.
CONJURE_URL=
CONJURE_PRODUCT_KEY=

# Opt-in v2fly geo annotation for Drive policy logs. Default off, so request
# handling stays unchanged until this is set. Datasets are fetched, not committed.
# INFINITUM_GEO_ENABLED=0
# INFINITUM_GEO_DIR=cloud/var/geo
# INFINITUM_GEO_LOCK=cloud/geo/geo.lock.json
